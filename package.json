{
  "name": "huocode-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --import ./tests/register.mjs --test 'tests/**/*.test.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "bash scripts/generate-api-client.sh",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm check:contrast && pnpm build"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "lucide-react": "0.460.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.16.0"
}
